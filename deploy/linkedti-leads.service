[Unit]
Description=LinkedTi lead intake and notification outbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linkedti-leads
Group=linkedti-leads
WorkingDirectory=/opt/linkedti-leads/current
ExecStart=/usr/bin/python3 /opt/linkedti-leads/current/leads.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=linkedti-leads
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linkedti-leads
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
